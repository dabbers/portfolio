---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { PROJECTS, STATUS_LABEL } from "@consts";
import type { ProjectStatus } from "@types";

const all = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const groups: { status: ProjectStatus; blurb: string }[] = [
  { status: "building", blurb: "Side projects under dab Media, in progress." },
  { status: "live", blurb: "Shipped and still running." },
  { status: "archived", blurb: "Retired, sold, or replaced. Kept here for the history." },
];
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-12">
      <div class="animate space-y-2">
        <h1 class="text-2xl">Projects</h1>
        <p class="text-stone-600 dark:text-stone-400">{PROJECTS.DESCRIPTION}</p>
      </div>
      {
        groups.map(({ status, blurb }) => {
          const items = all.filter((p) => p.data.status === status);
          if (items.length === 0) return null;
          return (
            <section class="animate space-y-4" id={status}>
              <div class="space-y-1">
                <h2 class="text-lg">{STATUS_LABEL[status]}</h2>
                <p class="text-sm text-stone-500 dark:text-stone-400">{blurb}</p>
              </div>
              <ul class="flex flex-col gap-3">
                {items.map((project) => (
                  <li>
                    <ProjectCard entry={project} />
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </Container>
</PageLayout>
