---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  // The homepage uses the bare site name as its <title>.
  bare?: boolean;
};

const { title, description, image, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={bare ? `${SITE.NAME} — ${title}` : `${title} | ${SITE.NAME}`} description={description} image={image} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
