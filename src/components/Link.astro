---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
};

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  class={cn(
    "text-accent transition-colors duration-200 ease-in-out",
    underline && "underline underline-offset-2 decoration-accent/40 hover:decoration-accent",
    className,
  )}
  {...rest}><slot /></a>
