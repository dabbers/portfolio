---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-1.5 font-mono text-sm text-stone-500 hover:text-accent dark:text-stone-400 transition-colors duration-200"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4 stroke-2 fill-none stroke-current" aria-hidden="true">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-2 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"></line>
    <polyline points="12 5 5 12 12 19" class="translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"></polyline>
  </svg>
  <slot />
</a>
