---
import type { ProjectStatus } from "@types";
import { STATUS_LABEL } from "@consts";
import { cn } from "@lib/utils";

type Props = {
  status: ProjectStatus;
  class?: string;
};

const { status, class: className } = Astro.props;

// Neutral tones on purpose: red is reserved for links and the name.
const tone = {
  live: "border-emerald-700/30 text-emerald-800 dark:border-emerald-400/30 dark:text-emerald-300",
  building: "border-amber-700/30 text-amber-800 dark:border-amber-400/30 dark:text-amber-300",
  archived: "border-stone-500/30 text-stone-600 dark:border-stone-400/30 dark:text-stone-400",
}[status];
---

<span class={cn("inline-flex items-center rounded border px-1.5 py-0.5 font-mono text-[11px] uppercase tracking-wide", tone, className)}>
  {STATUS_LABEL[status]}
</span>
